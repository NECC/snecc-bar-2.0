generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

 
model User {
  id                  String                @id @default(cuid())
  balance             Decimal               @default(0) @db.Decimal(10, 2)
  email               String                @unique
  emailVerified       DateTime?
  image               String?
  type                Roles                 @default(N_SOCIO)
  sessions            Session[]
  transactions        BalanceTransaction[]  @relation("UserAffected")
  handledTransactions BalanceTransaction[]  @relation("Handler")
  purchases           PurchaseTransaction[] @relation("UserPurchases")
 
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model Product {
  id                String    @id @default(cuid())
  name              String
  image             String?   @default("")
  stock             Stock[]
}

model Stock {
  id                String    @id @default(cuid())
  product_id        String
  quantity          Int
  acquisition_cost  Decimal   @default(0) @db.Decimal(10, 2)
  socio_price       Decimal   @default(0) @db.Decimal(10, 2)
  nsocio_price      Decimal   @default(0) @db.Decimal(10, 2)
  times_sold        PurchaseTransaction[]

  product           Product   @relation(fields: [product_id], references: [id])
}

model BalanceTransaction {
  id          String          @id @default(cuid())
  user_id     String
  type        TransactionType
  amount      Decimal         @default(0) @db.Decimal(10, 2)
  handler_id  String
  date        DateTime        @default(now())

  user        User            @relation("UserAffected", fields: [user_id], references: [id])
  handler     User            @relation("Handler", fields: [handler_id], references: [id])
}

model PurchaseTransaction {
  id            String      @id @default(cuid())
  user_id       String
  product_v_id  String
  date          DateTime    @default(now())

  user          User        @relation("UserPurchases", fields: [user_id], references: [id])
  product_v     Stock       @relation(fields: [product_v_id], references: [id])
}

enum Roles {
  ADMIN
  SOCIO
  N_SOCIO
}

enum TransactionType {
  CARREGAR
  RETIRAR
}