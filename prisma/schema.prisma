generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

 
model User {
  id                  String                @id @default(cuid())
  balance             Int                   @default(0)
  email               String                @unique
  emailVerified       DateTime?
  image               String?
  type                Roles                 @default(SOCIO)
  sessions            Session[]
  transactions        BalanceTransaction[]  @relation("UserAffected")
  handledTransactions BalanceTransaction[]  @relation("Handler")
  handledLosses       StockLoss[]           @relation("LossHandler")
  purchases           PurchaseTransaction[] @relation("UserPurchases")
 
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model Product {
  id                String    @id @default(cuid())
  name              String
  image             String?   @default("")
  stock             Stock[]
}

model Stock {
  id                String                @id @default(cuid())
  product_id        String
  quantity          Int
  acquisition_cost  Int                   @default(0)
  price             Int                   @default(0)
  createdAt         DateTime              @default(now())
  parcel_number     Int                   @default(1)
  times_sold        PurchaseTransaction[]
  lost              Int                   @default(0)

  product           Product               @relation(fields: [product_id], references: [id])
  losses            StockLoss[]
}

model StockLoss {
  id          String      @id @default(cuid())
  stock_id    String
  quantity    Int         @default(1)
  reason      LossReason?
  handler_id  String
  date        DateTime    @default(now())

  stock       Stock       @relation(fields: [stock_id], references: [id])
  handler     User        @relation("LossHandler", fields: [handler_id], references: [id])
}

model BalanceTransaction {
  id          String          @id @default(cuid())
  user_id     String
  type        TransactionType
  amount      Int             @default(0)
  handler_id  String
  date        DateTime        @default(now())

  user        User            @relation("UserAffected", fields: [user_id], references: [id])
  handler     User            @relation("Handler", fields: [handler_id], references: [id])
}

model PurchaseTransaction {
  id            String      @id @default(cuid())
  user_id       String
  product_v_id  String
  date          DateTime    @default(now())

  user          User        @relation("UserPurchases", fields: [user_id], references: [id])
  product_v     Stock       @relation(fields: [product_v_id], references: [id])
}

model Safe {
  id            String      @id @default(cuid())
  balance       Int         @default(0)
  last_updated  DateTime    @default(now())
}

enum Roles {
  ADMIN
  SOCIO
}

enum TransactionType {
  CARREGAR
  RETIRAR
}

enum LossReason {
  EXPIRED
  OTHER
}